import { MaterialText } from "./material_text.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialTypography } from "../styling/material_typography.slint";

export component ToolTip inherits Rectangle {
    in property <string> text;

    z: 10000;
    min-width: 0px;
    max-width: 200px;
    preferred-width: min(200px, layout.preferred-width);
    preferred-height: layout.preferred-height;
    border-radius: 4px;
    background: MaterialPalette.inverse_surface;

    layout := HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 0px;

        MaterialText {
            text: root.text;
            vertical-alignment: center;
            color: MaterialPalette.inverse_on_surface;
            style: MaterialTypography.body_small;
            wrap: word-wrap;
        }
    }
}
